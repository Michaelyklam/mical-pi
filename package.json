{
  "name": "mical-pi",
  "version": "1.0.0",
  "private": true,
  "description": "Michael's personal pi extensions, skills, prompts, and themes.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "postinstall": "node scripts/patch-pi-ai-claude-code-version.mjs && node scripts/patch-pi-ai-openrouter-cost.mjs && node scripts/patch-pi-coding-agent-compaction-cost.mjs && node scripts/patch-pi-coding-agent-compaction-lifecycle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "update:browser": "./scripts/update-agent-browser.sh",
    "check:browser": "./scripts/update-agent-browser.sh --check",
    "test": "npm run test:ask-user && npm run test:live-time && npm run test:effort && npm run test:shared && npm run test:usage-footer && npm run test:subagents && npm run test:plugin-receiver && npm run test:mcp-health && npm run test:session-aliases && npm run test:workflows && npm run test:self-compact && npm run test:patch",
    "test:ask-user": "tsx --test \"extensions/ask-user/**/*.test.ts\"",
    "test:live-time": "tsx --test \"extensions/live-time/**/*.test.ts\"",
    "test:effort": "tsx --test \"extensions/effort/**/*.test.ts\"",
    "test:shared": "tsx --test \"extensions/shared/**/*.test.ts\"",
    "test:usage-footer": "tsx --test \"extensions/usage-footer/**/*.test.ts\"",
    "test:patch": "node --test scripts/patch-pi-ai-openrouter-cost.test.mjs scripts/patch-pi-coding-agent-compaction-cost.test.mjs scripts/patch-pi-coding-agent-compaction-lifecycle.test.mjs",
    "test:subagents": "npm --prefix extensions/subagents test",
    "test:plugin-receiver": "tsx --test \"extensions/claude-plugin-receiver/**/*.test.ts\"",
    "test:mcp-health": "tsx --test \"extensions/mcp-health/**/*.test.ts\"",
    "test:session-aliases": "tsx --test \"extensions/session-aliases/**/*.test.ts\"",
    "test:workflows": "node --test --experimental-strip-types extensions/workflows/*.test.ts",
    "test:self-compact": "tsx --test \"extensions/self-compact/*.test.ts\"",
    "test:zg-bench": "node --test benchmarks/zg-pi/bench.test.mjs",
    "bench:zg:index": "node benchmarks/zg-pi/bench.mjs index",
    "bench:zg": "node benchmarks/zg-pi/bench.mjs run",
    "bench:zg:sweqa:setup": "node benchmarks/zg-pi/setup-sweqa-smoke.mjs",
    "bench:zg:sweqa:smoke": "node benchmarks/zg-pi/run-sweqa-smoke.mjs",
    "bench:zg:sweqa:summary": "node benchmarks/zg-pi/summarize-sweqa.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "acorn": "^8.18.0",
    "effect": "^4.0.0-beta.99",
    "firecrawl": "^4.31.1",
    "pi-unified-exec": "0.9.1"
  },
  "bundledDependencies": [
    "pi-unified-exec"
  ],
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/pi-unified-exec/src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
